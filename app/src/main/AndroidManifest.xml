<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET exists ONLY for the clean feeds (CleanFeedActivity): a WebView that
         talks to instagram.com / facebook.com directly. Nothing goes to our own
         servers. Before release: re-check Data Safety + the privacy policy, and
         Play Billing's datatransport telemetry, which this permission now lets
         through (it was stripped while the app was fully offline). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility (API 30+): launchable apps for the picker and launcher detection -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>

    <application
        android:name=".StayFreeApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StayFree"
        tools:targetApi="33">

        <!-- Main Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.StayFree.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false" />

        <!-- Whole-app block screen. Like ContentBlockActivity it is started by the
             accessibility service, whose system binding exempts it from the
             background-launch limits — no SYSTEM_ALERT_WINDOW needed. -->
        <activity
            android:name=".ui.overlay.BlockOverlayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.StayFree.Overlay" />

        <!-- Content hard-block — covers the host app the moment a blocked
             short-form surface (Reels/Stories/Shorts/TikTok) is detected. -->
        <activity
            android:name=".ui.content.ContentBlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.StayFree.ContentBlock" />

        <!-- Short unlock, opened from either block screen. -->
        <activity
            android:name=".ui.unlock.ShortUnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.StayFree" />

        <!-- Clean Instagram / Facebook / YouTube (premium): the site on a feed of followed
             accounts, with a scroll limit. One activity per network, singleTask: the
             block screen and Block Apps reopen the same page instead of stacking
             copies. configChanges: a rotation must not reload the feed. -->
        <activity
            android:name=".ui.cleanfeed.CleanInstagramActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.StayFree"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.cleanfeed.CleanFacebookActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.StayFree"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.cleanfeed.CleanYouTubeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.StayFree"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.premium.PaywallActivity"
            android:exported="false"
            android:theme="@style/Theme.StayFree"
            android:windowSoftInputMode="adjustResize" />

        <!-- Foreground Service — specialUse: continuous on-device screen-time
             tracking; dataSync would get a 6h timeout + boot-launch ban on
             targetSdk 35 -->
        <service
            android:name=".service.UsageTrackingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous on-device screen-time tracking that powers the user's app-blocking limits and statistics. No data leaves the device." />
        </service>

        <!-- Accessibility Service -->
        <service
            android:name=".service.StayFreeAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- WorkManager: on-demand initialization (StayFreeApp implements
             Configuration.Provider with the Hilt worker factory) — the default
             initializer must be removed or workers won't be Hilt-injected. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Per-app locale persistence below API 33 (appcompat autoStoreLocales) -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Receivers -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
