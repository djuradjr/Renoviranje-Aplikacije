<?xml version="1.0" encoding="utf-8"?>
<!-- Skor "Zastita": what is blocked right now, each with its way in (short unlock),
     then the rules. Every tool and the full block list live behind the rules arrow
     (BlockingRulesFragment). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/skor_ground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                style="@style/Skor.Title"
                android:text="@string/blocking_tools_title" />

            <TextView
                android:id="@+id/tv_status"
                style="@style/Skor.Caption"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="@dimen/spacing_sm"
                android:gravity="center_vertical"
                tools:text="@string/blocking_status_strict_on" />

            <!-- Only without premium: blocking is the paid feature, and the blocks the
                 user set up stay stored until it is back. -->
            <LinearLayout
                android:id="@+id/card_premium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:background="@drawable/bg_skor_card"
                android:backgroundTint="@color/skor_focus_soft"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Skor.Body"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:text="@string/blocking_premium_title"
                    android:textFontWeight="700"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_lock"
                    app:drawableTint="@color/skor_focus" />

                <TextView
                    style="@style/Skor.Caption"
                    android:layout_width="match_parent"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/blocking_premium_desc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_premium"
                    style="@style/Skor.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/blocking_premium_cta" />
            </LinearLayout>

            <!-- Premium without the blocking permissions (bought after skipping them in
                 onboarding, or a permission revoked): nothing would be blocked. -->
            <LinearLayout
                android:id="@+id/card_setup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:background="@drawable/bg_skor_card"
                android:backgroundTint="@color/skor_warn_soft"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Skor.Body"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:text="@string/blocking_setup_title"
                    android:textFontWeight="700"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_shield"
                    app:drawableTint="@color/skor_warn" />

                <TextView
                    style="@style/Skor.Caption"
                    android:layout_width="match_parent"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/blocking_setup_desc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup"
                    style="@style/Skor.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/blocking_setup_cta" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/skor_text_dim" />

                <TextView
                    style="@style/Skor.Title"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:text="@string/blocking_section_apps" />

                <ImageButton
                    android:id="@+id/btn_add_app"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_round_focus_soft"
                    android:contentDescription="@string/blocking_add_app_cd"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add"
                    app:tint="@color/skor_focus" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="-16dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                tools:itemCount="5"
                tools:listitem="@layout/item_blocked_app" />

            <TextView
                android:id="@+id/tv_apps_empty"
                style="@style/Skor.Caption"
                android:text="@string/blocking_apps_empty"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tool_globe"
                    app:tint="@color/skor_text_dim" />

                <TextView
                    style="@style/Skor.Title"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:text="@string/blocking_section_sites" />

                <ImageButton
                    android:id="@+id/btn_add_site"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_round_focus_soft"
                    android:contentDescription="@string/blocking_add_site_cd"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add"
                    app:tint="@color/skor_focus" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_sites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-4dp"
                android:layout_marginEnd="-4dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="4"
                tools:listitem="@layout/item_blocked_site" />

            <TextView
                android:id="@+id/tv_sites_empty"
                style="@style/Skor.Caption"
                android:text="@string/blocking_sites_empty"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Skor.Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:text="@string/blocking_rules_title" />

                <ImageButton
                    android:id="@+id/btn_rules"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_round_raised"
                    android:contentDescription="@string/blocking_open_rules_cd"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/skor_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/card_focus"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_skor_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_tile_focus_soft"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/ic_timer"
                            app:tint="@color/skor_focus" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_arrow_right"
                            app:tint="@color/skor_text_dim" />

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_tile_focus_soft"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/skor_focus" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_focus_pill"
                        style="@style/Skor.Chip"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:fontFeatureSettings="tnum"
                        tools:text="14 min" />

                    <TextView
                        style="@style/Skor.Title"
                        android:layout_marginTop="12dp"
                        android:textSize="16sp"
                        android:text="@string/blocking_focus_card_title" />

                    <TextView
                        style="@style/Skor.Caption"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/blocking_focus_desc" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_add_rule"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_skor_card_dashed"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_round_focus_soft"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/skor_focus" />

                    <TextView
                        style="@style/Skor.Chip"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:background="@drawable/bg_skor_chip_outline"
                        android:text="@string/blocking_add_rule_pill"
                        android:textColor="@color/skor_text_dim" />

                    <TextView
                        style="@style/Skor.Title"
                        android:layout_marginTop="12dp"
                        android:textSize="16sp"
                        android:text="@string/blocking_add_rule_title" />

                    <TextView
                        style="@style/Skor.Caption"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/blocking_add_rule_desc" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
