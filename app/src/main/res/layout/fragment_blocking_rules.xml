<?xml version="1.0" encoding="utf-8"?>
<!-- "Pravila": every tool and every active block, reached from the arrow on the
     Blocking tab. The tab itself shows only what is blocked right now. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/skor_ground">

    <include
        android:id="@+id/back_header"
        layout="@layout/view_back_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_md">

            <TextView
                style="@style/Skor.Title"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/blocking_rules_title" />

            <TextView
                style="@style/Skor.Label"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/blocking_tools_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_skor_card"
                android:layout_marginBottom="@dimen/spacing_md">

                <!-- 1 · Apps and content -->
                <LinearLayout
                    android:id="@+id/btn_in_app_blocking"
                    style="@style/Skor.ToolRow">

                    <ImageView
                        style="@style/Skor.ToolIcon"
                        android:src="@drawable/ic_tool_shield"
                        app:tint="@color/skor_distraction"
                        android:backgroundTint="@color/skor_distraction_soft" />

                    <LinearLayout style="@style/Skor.ToolText">

                        <TextView style="@style/Skor.Body" android:text="@string/blocking_block_apps" />

                        <TextView
                            style="@style/Skor.Micro"
                            android:layout_marginTop="1dp"
                            android:text="@string/blocking_block_apps_desc" />
                    </LinearLayout>

                    <TextView android:id="@+id/status_block_apps" style="@style/Skor.ToolStatusNew" />
                </LinearLayout>

                <View style="@style/Skor.Divider" />

                <!-- 2 · Websites -->
                <LinearLayout
                    android:id="@+id/btn_website_blocking"
                    style="@style/Skor.ToolRow">

                    <ImageView
                        style="@style/Skor.ToolIcon"
                        android:src="@drawable/ic_tool_globe"
                        app:tint="@color/skor_text_dim"
                        android:backgroundTint="@color/skor_card_raised" />

                    <LinearLayout style="@style/Skor.ToolText">

                        <TextView style="@style/Skor.Body" android:text="@string/blocking_websites" />

                        <TextView
                            style="@style/Skor.Micro"
                            android:layout_marginTop="1dp"
                            android:text="@string/blocking_websites_desc" />
                    </LinearLayout>

                    <TextView android:id="@+id/status_websites" style="@style/Skor.ToolStatusNew" />
                </LinearLayout>

                <View style="@style/Skor.Divider" />

                <!-- 3 · Focus -->
                <LinearLayout
                    android:id="@+id/btn_focus_mode"
                    style="@style/Skor.ToolRow">

                    <ImageView
                        style="@style/Skor.ToolIcon"
                        android:src="@drawable/ic_tool_focus"
                        app:tint="@color/skor_focus"
                        android:backgroundTint="@color/skor_focus_soft" />

                    <LinearLayout style="@style/Skor.ToolText">

                        <TextView style="@style/Skor.Body" android:text="@string/blocking_focus_mode" />

                        <TextView
                            style="@style/Skor.Micro"
                            android:layout_marginTop="1dp"
                            android:text="@string/blocking_focus_desc" />
                    </LinearLayout>

                    <TextView android:id="@+id/status_focus" style="@style/Skor.ToolStatusNew" />
                </LinearLayout>

                <View style="@style/Skor.Divider" />

                <!-- 4 · Sleep -->
                <LinearLayout
                    android:id="@+id/btn_sleep_mode"
                    style="@style/Skor.ToolRow">

                    <ImageView
                        style="@style/Skor.ToolIcon"
                        android:src="@drawable/ic_tool_moon"
                        app:tint="@color/skor_night"
                        android:backgroundTint="@color/skor_night_soft" />

                    <LinearLayout style="@style/Skor.ToolText">

                        <TextView style="@style/Skor.Body" android:text="@string/blocking_sleep_mode" />

                        <TextView
                            style="@style/Skor.Micro"
                            android:layout_marginTop="1dp"
                            android:text="@string/blocking_sleep_desc" />
                    </LinearLayout>

                    <TextView android:id="@+id/status_sleep" style="@style/Skor.ToolStatusNew" />
                </LinearLayout>

                <View style="@style/Skor.Divider" />

                <!-- 5 · Strict mode -->
                <LinearLayout
                    android:id="@+id/btn_strict_mode"
                    style="@style/Skor.ToolRow">

                    <ImageView
                        style="@style/Skor.ToolIcon"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/skor_focus"
                        android:backgroundTint="@color/skor_focus_soft" />

                    <LinearLayout style="@style/Skor.ToolText">

                        <TextView style="@style/Skor.Body" android:text="@string/strict_title" />

                        <TextView
                            style="@style/Skor.Micro"
                            android:layout_marginTop="1dp"
                            android:text="@string/strict_desc" />
                    </LinearLayout>

                    <TextView android:id="@+id/status_strict" style="@style/Skor.ToolStatusNew" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_sm">

                <TextView
                    style="@style/Skor.Label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/blocking_app_rules" />

                <TextView
                    android:id="@+id/tv_rules_count"
                    style="@style/Skor.Micro"
                    tools:text="3 aktivna" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_block_rules"
                android:layoutAnimation="@anim/layout_animation_slide_up"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="@dimen/spacing_lg"
                android:background="@drawable/bg_skor_card"
                android:visibility="gone">

                <TextView
                    style="@style/Skor.Body"
                    android:text="@string/blocking_rules_empty" />

                <TextView
                    style="@style/Skor.Micro"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/blocking_rules_empty_desc" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
