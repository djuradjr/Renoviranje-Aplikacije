<?xml version="1.0" encoding="utf-8"?>
<!-- Strict mode. One screen for both states: off (pick a length, lock) and running
     (ring drains, the only action left is extending). There is no stop button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/skor_ground">

    <include
        android:id="@+id/back_header"
        layout="@layout/view_back_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_md">

            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp">

                <com.example.stayfree.ui.common.ScoreRingView
                    android:id="@+id/ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/iv_lock"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_lock"
                        android:importantForAccessibility="no"
                        app:tint="@color/skor_text_dim" />

                    <TextView
                        android:id="@+id/tv_countdown"
                        style="@style/Skor.Metric"
                        android:textColor="@color/skor_focus"
                        android:visibility="gone"
                        tools:text="2d 04:12:33" />

                    <TextView
                        android:id="@+id/tv_ring_label"
                        style="@style/Skor.Label"
                        android:layout_marginTop="8dp"
                        tools:text="@string/strict_ring_off" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tv_headline"
                style="@style/Skor.Title"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center"
                tools:text="@string/strict_headline_off" />

            <TextView
                android:id="@+id/tv_body"
                style="@style/Skor.Caption"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                tools:text="@string/strict_body_off" />

            <TextView
                android:id="@+id/tv_violations"
                style="@style/Skor.Chip"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/skor_warn_soft"
                android:textColor="@color/skor_warn"
                android:visibility="gone"
                tools:text="2 violations during this lock"
                tools:visibility="visible" />

            <TextView
                style="@style/Skor.Label"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/strict_social_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:background="@drawable/bg_skor_card">

                <TextView
                    android:id="@+id/tv_social_apps"
                    style="@style/Skor.Body"
                    android:textColor="@color/skor_distraction"
                    tools:text="Instagram · TikTok · YouTube" />

                <TextView
                    style="@style/Skor.Caption"
                    android:layout_marginTop="8dp"
                    android:text="@string/strict_social_body" />
            </LinearLayout>

            <TextView
                style="@style/Skor.Label"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/strict_locks_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:background="@drawable/bg_skor_card">

                <TextView
                    style="@style/Skor.Body"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:text="@string/strict_locks_blocks"
                    app:drawableStartCompat="@drawable/ic_lock"
                    app:drawableTint="@color/skor_focus" />

                <TextView
                    style="@style/Skor.Body"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:text="@string/strict_locks_limits"
                    app:drawableStartCompat="@drawable/ic_lock"
                    app:drawableTint="@color/skor_focus" />

                <TextView
                    style="@style/Skor.Body"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:text="@string/strict_locks_modes"
                    app:drawableStartCompat="@drawable/ic_lock"
                    app:drawableTint="@color/skor_focus" />

                <TextView
                    style="@style/Skor.Body"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:text="@string/strict_locks_misc"
                    app:drawableStartCompat="@drawable/ic_lock"
                    app:drawableTint="@color/skor_focus" />
            </LinearLayout>

            <TextView
                style="@style/Skor.Micro"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/strict_honest_note" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="true">

                <!-- Debug builds only: short enough to watch a lock run out. -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_debug"
                    style="@style/Skor.DurationChip"
                    android:text="2 min"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_1h"
                    style="@style/Skor.DurationChip"
                    android:text="@string/strict_duration_1h" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_today"
                    style="@style/Skor.DurationChip"
                    android:text="@string/strict_duration_today" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_24h"
                    style="@style/Skor.DurationChip"
                    android:text="@string/strict_duration_24h" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_7d"
                    style="@style/Skor.DurationChip"
                    android:checked="true"
                    android:text="@string/strict_duration_7d" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_30d"
                    style="@style/Skor.DurationChip"
                    android:text="@string/strict_duration_30d" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_lock"
            style="@style/Skor.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            tools:text="Lock · 7 days" />
    </LinearLayout>
</LinearLayout>
