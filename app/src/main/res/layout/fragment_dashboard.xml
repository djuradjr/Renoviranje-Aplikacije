<?xml version="1.0" encoding="utf-8"?>
<!-- D4 dashboard: score + ring under a 3D brain, a teal blade of light
     running down behind the glass cards. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/skor_ground"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Teal haze from both screen edges, from the brain down (top set in code). -->
        <com.example.stayfree.ui.common.SideGlowView
            android:id="@+id/side_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <!-- Behind the cards: starts under the brain (top set in code), ends in a point below the content. -->
        <com.example.stayfree.ui.common.GlowBladeView
            android:id="@+id/glow_blade"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/dashboard_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dash_margin"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="@dimen/dash_bottom_space">

            <com.example.stayfree.ui.common.SegmentedPillView
                android:id="@+id/seg_periods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- The system killed the accessibility service: blocking is silently off. -->
            <LinearLayout
                android:id="@+id/card_protection_stopped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dash_gap"
                android:background="@drawable/bg_skor_card"
                android:backgroundTint="@color/skor_warn_soft"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Skor.Body"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:text="@string/protection_stopped_title"
                    android:textFontWeight="700"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_shield"
                    app:drawableTint="@color/skor_warn" />

                <TextView
                    style="@style/Skor.Caption"
                    android:layout_width="match_parent"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/protection_stopped_desc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_protection_restart"
                    style="@style/Skor.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/protection_stopped_cta" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_protection_battery"
                    style="@style/Skor.Button.Neutral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/protection_battery_cta" />
            </LinearLayout>

            <!-- ============================ DAY ============================ -->
            <LinearLayout
                android:id="@+id/daily_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_prev_day"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="-8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/dashboard_prev_day"
                        android:src="@drawable/ic_chevron_left"
                        app:tint="@color/skor_text_muted" />

                    <TextView
                        android:id="@+id/tv_date"
                        style="@style/Skor.Date"
                        android:layout_marginHorizontal="2dp"
                        tools:text="Petak, 20. nov" />

                    <ImageButton
                        android:id="@+id/btn_next_day"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/dashboard_next_day"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/skor_text_muted" />
                </LinearLayout>

                <!-- Hero: score left, ring right, the brain floating between them. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dash_hero_height"
                    android:layout_marginTop="@dimen/spacing_xs">

                    <ImageView
                        android:id="@+id/iv_brain"
                        android:layout_width="@dimen/dash_brain_width"
                        android:layout_height="@dimen/dash_brain_height"
                        android:layout_gravity="center_horizontal|top"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_dashboard_brain" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Skor.Subtitle"
                            android:text="@string/dashboard_focus_score" />

                        <TextView
                            android:id="@+id/tv_score"
                            style="@style/Skor.Score"
                            android:layout_marginTop="@dimen/spacing_xs"
                            tools:text="76" />
                    </LinearLayout>

                    <com.example.stayfree.ui.common.ScoreRingView
                        android:id="@+id/score_ring"
                        android:layout_width="@dimen/dash_ring_size"
                        android:layout_height="@dimen/dash_ring_size"
                        android:layout_gravity="end|center_vertical" />
                </FrameLayout>

                <!-- Po satima -->
                <FrameLayout
                    android:id="@+id/hourly_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dash_gap">

                    <com.example.stayfree.ui.common.GlassCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dash_hourly_card_height"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_md">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    style="@style/Skor.CardTitle"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:text="@string/dashboard_hourly_title" />

                                <TextView
                                    android:id="@+id/tv_peak_time"
                                    style="@style/Skor.Date"
                                    android:fontFeatureSettings="tnum"
                                    android:textFontWeight="400"
                                    tools:text="Najviše u 21h" />
                            </LinearLayout>

                            <com.example.stayfree.ui.common.HourlyBarsView
                                android:id="@+id/chart_hourly"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginTop="12dp"
                                android:layout_weight="1" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp">

                                <TextView style="@style/Skor.Micro" android:layout_width="0dp" android:layout_weight="1" android:text="@string/dashboard_axis_0" />
                                <TextView style="@style/Skor.Micro" android:layout_width="0dp" android:layout_weight="1" android:text="@string/dashboard_axis_6" />
                                <TextView style="@style/Skor.Micro" android:layout_width="0dp" android:layout_weight="1" android:text="@string/dashboard_axis_12" />
                                <TextView style="@style/Skor.Micro" android:layout_width="0dp" android:layout_weight="1" android:text="@string/dashboard_axis_18" />
                                <TextView style="@style/Skor.Micro" android:text="@string/dashboard_axis_24" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.example.stayfree.ui.common.GlassCardView>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dash_gap"
                    android:baselineAligned="false">

                    <com.example.stayfree.ui.common.MetricCardView
                        android:id="@+id/metric_screen"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:layout_weight="1" />

                    <com.example.stayfree.ui.common.MetricCardView
                        android:id="@+id/metric_unlocks"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1" />
                </LinearLayout>

                <com.example.stayfree.ui.common.StreakRowView
                    android:id="@+id/streak_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dash_gap" />

                <LinearLayout
                    android:id="@+id/row_top_apps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dash_gap"
                    android:baselineAligned="false">

                    <com.example.stayfree.ui.common.AppUsageTileView
                        android:id="@+id/tile_app_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dash_tile_gap"
                        android:layout_weight="1" />

                    <com.example.stayfree.ui.common.AppUsageTileView
                        android:id="@+id/tile_app_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dash_tile_gap"
                        android:layout_weight="1" />

                    <com.example.stayfree.ui.common.AppUsageTileView
                        android:id="@+id/tile_app_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dash_tile_gap"
                        android:layout_weight="1" />

                    <com.example.stayfree.ui.common.AppUsageTileView
                        android:id="@+id/tile_app_4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- ======================== WEEK / MONTH ======================== -->
            <LinearLayout
                android:id="@+id/period_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_period_pill"
                    style="@style/Skor.Date"
                    android:layout_marginTop="12dp"
                    android:paddingVertical="6dp"
                    tools:text="Poslednjih 7 dana" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dash_hero_height"
                    android:layout_marginTop="@dimen/spacing_xs">

                    <ImageView
                        android:id="@+id/iv_period_brain"
                        android:layout_width="@dimen/dash_brain_width"
                        android:layout_height="@dimen/dash_brain_height"
                        android:layout_gravity="center_horizontal|top"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_dashboard_brain" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Skor.Subtitle"
                            android:text="@string/dashboard_period_score_title" />

                        <TextView
                            android:id="@+id/tv_period_score"
                            style="@style/Skor.Score"
                            android:layout_marginTop="@dimen/spacing_xs"
                            tools:text="64" />
                    </LinearLayout>

                    <com.example.stayfree.ui.common.ScoreRingView
                        android:id="@+id/period_score_ring"
                        android:layout_width="@dimen/dash_ring_size"
                        android:layout_height="@dimen/dash_ring_size"
                        android:layout_gravity="end|center_vertical" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/row_period_metrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dash_gap"
                    android:baselineAligned="false">

                    <com.example.stayfree.ui.common.MetricCardView
                        android:id="@+id/metric_period_avg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:layout_weight="1" />

                    <com.example.stayfree.ui.common.MetricCardView
                        android:id="@+id/metric_period_unlocks"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dash_gap"
                    android:baselineAligned="false">

                    <com.example.stayfree.ui.common.MetricCardView
                        android:id="@+id/metric_period_total"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:layout_weight="1" />

                    <com.example.stayfree.ui.common.MetricCardView
                        android:id="@+id/metric_period_in_goal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- Per-day activity line chart -->
                <com.example.stayfree.ui.common.GlassCardView
                    android:id="@+id/card_period_chart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dash_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_sm"
                            android:gravity="center_vertical">

                            <TextView
                                style="@style/Skor.CardTitle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/stats_activity" />

                            <TextView
                                android:id="@+id/tv_trend"
                                style="@style/Skor.Chip"
                                android:visibility="gone"
                                tools:text="6% manje"
                                tools:visibility="visible" />
                        </LinearLayout>

                        <com.example.stayfree.ui.common.UsageLineChartView
                            android:id="@+id/chart_period"
                            android:layout_width="match_parent"
                            android:layout_height="170dp"
                            app:axisTextColor="@color/skor_text_faint"
                            app:gridColor="@color/skor_line"
                            app:lineColor="@color/skor_focus"
                            app:markPeak="true"
                            app:markerSolidColor="@android:color/white"
                            app:markersAllPoints="true"
                            app:tooltipValueColor="@color/skor_text" />
                    </LinearLayout>
                </com.example.stayfree.ui.common.GlassCardView>

                <TextView
                    style="@style/Skor.CardTitle"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="@string/dashboard_most_used_apps" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_period_apps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutAnimation="@anim/layout_animation_slide_up"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</ScrollView>
