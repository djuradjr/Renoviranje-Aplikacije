<?xml version="1.0" encoding="utf-8"?>
<!-- Clean Instagram: a slim Skor header (title + posts-left counter), then
     Instagram's stories tray above the Following feed. At the post limit the
     feed itself ends in a card drawn by CleanFeedRules.INJECTED_JS. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/skor_ground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/skor_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clean_feed_close"
            android:src="@drawable/ic_close"
            app:tint="@color/skor_text" />

        <TextView
            android:id="@+id/tv_title"
            style="@style/Skor.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/clean_feed_title"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_counter"
            style="@style/Skor.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            tools:text="4 / 20" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        app:indicatorColor="@color/skor_focus"
        app:trackColor="@android:color/transparent"
        app:trackThickness="2dp" />

    <!-- Instagram's stories tray, cut out of the home page; height set once measured. -->
    <WebView
        android:id="@+id/web_stories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
