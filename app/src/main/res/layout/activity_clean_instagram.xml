<?xml version="1.0" encoding="utf-8"?>
<!-- Clean Instagram: a slim Skor header (title + posts-left counter) over
     instagram.com. When the scroll limit is spent a calm cover takes the feed;
     orange only on the block mark, as on every block screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/skor_ground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/skor_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clean_feed_close"
            android:src="@drawable/ic_close"
            app:tint="@color/skor_text" />

        <TextView
            android:id="@+id/tv_title"
            style="@style/Skor.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/clean_feed_title"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_counter"
            style="@style/Skor.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            tools:text="4 / 20" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        app:indicatorColor="@color/skor_focus"
        app:trackColor="@android:color/transparent"
        app:trackThickness="2dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Clickable so no touch reaches the feed underneath. -->
        <LinearLayout
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/skor_ground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_skor_dot"
                android:backgroundTint="@color/skor_distraction_soft">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_block"
                    app:tint="@color/skor_distraction" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_cover_title"
                style="@style/Skor.Text"
                android:gravity="center"
                android:letterSpacing="-0.025"
                android:textFontWeight="700"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="That's 20 posts" />

            <TextView
                android:id="@+id/tv_cover_message"
                style="@style/Skor.Text"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/skor_text_dim"
                android:textSize="15sp"
                tools:text="Your feed rests until 14:35. Messages are still open." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cover_messages"
                style="@style/Skor.Button.Quiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/clean_feed_messages" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cover_exit"
                style="@style/Skor.Button.Neutral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/content_block_exit" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
