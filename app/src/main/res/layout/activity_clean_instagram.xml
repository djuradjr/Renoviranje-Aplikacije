<?xml version="1.0" encoding="utf-8"?>
<!-- Clean Instagram: a slim Skor header (title + posts-left counter), then
     Instagram's stories tray above the Following feed. At the post limit the
     feed itself ends in a card drawn by CleanFeedRules.INJECTED_JS. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/skor_ground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/skor_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clean_feed_close"
            android:src="@drawable/ic_close"
            app:tint="@color/skor_text" />

        <TextView
            android:id="@+id/tv_title"
            style="@style/Skor.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/clean_feed_title"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_counter"
            style="@style/Skor.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            tools:text="4 / 20" />

        <!-- Instagram's own header (with this heart) is hidden on the feed. -->
        <ImageButton
            android:id="@+id/btn_activity"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="-8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clean_feed_activity"
            android:src="@drawable/ic_heart_outline"
            app:tint="@color/skor_text" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        app:indicatorColor="@color/skor_focus"
        app:trackColor="@android:color/transparent"
        app:trackThickness="2dp" />

    <!-- Instagram's stories tray, cut out of the home page; height set once measured. -->
    <WebView
        android:id="@+id/web_stories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- A post or reel opened outside the feed once the session's posts are
             spent. Clickable so no touch reaches the page underneath. -->
        <LinearLayout
            android:id="@+id/post_limit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/skor_ground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/Skor.Text"
                android:gravity="center"
                android:text="@string/clean_feed_post_limit_title"
                android:textFontWeight="700"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_post_limit_message"
                style="@style/Skor.Text"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/skor_text_dim"
                android:textSize="15sp"
                tools:text="More posts at 21:30." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_post_limit_messages"
                style="@style/Skor.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/clean_feed_to_messages" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_post_limit_back"
                style="@style/Skor.Button.Quiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/clean_feed_back" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
