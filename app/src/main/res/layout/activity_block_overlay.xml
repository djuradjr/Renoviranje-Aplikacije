<?xml version="1.0" encoding="utf-8"?>
<!-- D4 app block: plain black (draws on the first frame), calm copy, no guilt.
     Order of ways out: clean feed (Instagram) → short unlock → back home. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingVertical="@dimen/spacing_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_skor_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingVertical="28dp">

            <include
                android:id="@+id/app_mark"
                layout="@layout/view_block_app_mark" />

            <TextView
                android:id="@+id/tv_block_reason"
                style="@style/Skor.BlockTitle"
                android:layout_marginTop="20dp"
                tools:text="Strogi režim drži Instagram zatvorenim" />

            <TextView
                android:id="@+id/tv_app_name"
                style="@style/Skor.Date"
                android:layout_marginTop="6dp"
                android:gravity="center"
                tools:text="Instagram" />

            <TextView
                android:id="@+id/tv_unlock_tally"
                style="@style/Skor.Caption"
                android:layout_marginTop="12dp"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:visibility="gone"
                tools:text="Danas otključano: 1× · 5 min"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_strict"
                style="@style/Skor.Caption"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:visibility="gone" />
        </LinearLayout>

        <include
            android:id="@+id/clean_feed"
            layout="@layout/view_clean_feed_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_clean_caption"
            style="@style/Skor.Caption"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:text="@string/block_clean_caption"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_unlock"
            style="@style/Skor.Button.Quiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/unlock_briefly" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_override"
            style="@style/Skor.Button.Quiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/btn_override"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_pin_hint"
            style="@style/Skor.Caption"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:text="@string/overlay_set_pin_hint"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_go_back"
            style="@style/Skor.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/block_back" />
    </LinearLayout>
</ScrollView>
