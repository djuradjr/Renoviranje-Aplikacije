<?xml version="1.0" encoding="utf-8"?>
<!-- D4 content block (Reels, Stories, Shorts, TikTok): plain black like the app block,
     the host app's icon in the orange ring, a calm line, no timer. Back and "Back" go home. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/block_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingVertical="@dimen/spacing_xl">

        <TextView
            android:id="@+id/tv_motivation"
            style="@style/Skor.BlockTitle"
            android:layout_width="match_parent"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:textColor="@color/skor_text_subtitle"
            android:textFontWeight="500"
            android:textSize="20sp"
            android:textStyle="normal"
            tools:text="Your life is happening off-screen." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_skor_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingVertical="28dp">

            <include
                android:id="@+id/app_mark"
                layout="@layout/view_block_app_mark" />

            <TextView
                android:id="@+id/tv_title"
                style="@style/Skor.BlockTitle"
                android:layout_marginTop="20dp"
                tools:text="Reels blocked" />

            <TextView
                android:id="@+id/tv_message"
                style="@style/Skor.Caption"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/content_block_message"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_unlock_tally"
                style="@style/Skor.Caption"
                android:layout_marginTop="12dp"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:visibility="gone"
                tools:text="Danas otključano: 3× · 27 min"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_strict"
                style="@style/Skor.Caption"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:visibility="gone"
                tools:text="Strogi režim · još 2d 4h"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- The count that proves the app is doing its job. Same number as the
             dashboard and the protection tab. -->
        <LinearLayout
            android:id="@+id/card_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_skor_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_md"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_block_count"
                style="@style/Skor.MetricSmall"
                android:textColor="@color/skor_focus"
                tools:text="23" />

            <TextView
                android:id="@+id/tv_block_count_caption"
                style="@style/Skor.Caption"
                android:layout_width="0dp"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.25"
                tools:text="puta danas te je Block Doomscroll zaustavio" />
        </LinearLayout>

        <include
            android:id="@+id/clean_feed"
            layout="@layout/view_clean_feed_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_clean_caption"
            style="@style/Skor.Caption"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:text="@string/block_clean_caption"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_unlock"
            style="@style/Skor.Button.Quiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/unlock_briefly" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_exit"
            style="@style/Skor.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/block_back" />
    </LinearLayout>
</ScrollView>
